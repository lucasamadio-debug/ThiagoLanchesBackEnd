{
	"$schema": "https://opencode.ai/config.json",
	"permission": {
		"read": {
			"*": "allow",
			"*.env": "deny",
			"*.env.*": "deny",
			"*.env.example": "allow"
		},
		"bash": {
			"*": "ask",
			"npm *": "allow",
			"npx tsc *": "allow",
			"git status": "allow",
			"git diff *": "allow"
		}
	}
}